 gl::EGLDisplayPlatform GLOzoneEGLWayland::GetNativeDisplay() {
+#if defined(WAYLAND_GBM)
+  // The readback surface is a pbuffer. Mesa's surfaceless platform takes
+  // EGL_DEFAULT_DISPLAY, whereas the GBM platform takes a gbm_device.
+  const auto angle = gl::GetGLImplementationParts().angle;
+  if (base::FeatureList::IsEnabled(kWaylandGLReadbackPresentation) &&
+      (angle == gl::ANGLEImplementation::kOpenGL ||
+       angle == gl::ANGLEImplementation::kOpenGLES ||
+       angle == gl::ANGLEImplementation::kDefault)) {
+    return gl::EGLDisplayPlatform(EGL_DEFAULT_DISPLAY,
+                                  EGL_PLATFORM_SURFACELESS_MESA);
+  }
+#endif
   if (connection_) {
     return connection_->GetNativeDisplay();
   }
